# The upstream bundle is a frozen Python application (PyInstaller) under
# /usr/libexec/aws-cli: its own libpython, extension modules (two of them
# carry upstream's build-time RUNPATH) and data files, loaded from that
# directory only and excluded from automatic library Provides/Requires.
addFilter(".* /usr/libexec/aws-cli/")
addFilter("E: files-duplicated-waste")
addFilter("W: python-missing-require")
