Name:           doctl
Version:        2.6.0
Release:        0
%global debug_package %{nil}
Summary:        Official command-line interface for the DigitalOcean API
License:        Apache-2.0
URL:            https://docs.digitalocean.com/reference/doctl/
Source0:        doctl-%{version}-linux-amd64.tar.gz
Source1:        LICENSE.txt
ExclusiveArch:  x86_64

%description
doctl is DigitalOcean's official command-line interface. It manages
Droplets, Kubernetes clusters, App Platform apps, databases, Spaces keys,
DNS and the rest of the DigitalOcean API from the terminal. This package
repackages the upstream prebuilt, statically linked release for the signed
Lyra OS OBS repositories, following the official "install from the GitHub
release" instructions, and ships shell completions generated by doctl.

%prep
%setup -q -c -T
tar -xzf %{SOURCE0}
cp %{SOURCE1} .

%build
# Prebuilt upstream binary release; there is no compilation step.
./doctl completion bash > doctl.bash
./doctl completion zsh > doctl.zsh
./doctl completion fish > doctl.fish

%install
install -D -m 0755 doctl %{buildroot}%{_bindir}/doctl
install -D -m 0644 doctl.bash %{buildroot}%{_datadir}/bash-completion/completions/doctl
install -D -m 0644 doctl.zsh %{buildroot}%{_datadir}/zsh/site-functions/_doctl
install -D -m 0644 doctl.fish %{buildroot}%{_datadir}/fish/vendor_completions.d/doctl.fish

%check
%{buildroot}%{_bindir}/doctl version | grep -q 'doctl version %{version}'

%files
%license LICENSE.txt
%{_bindir}/doctl
%{_datadir}/bash-completion/completions/doctl
%dir %{_datadir}/zsh
%dir %{_datadir}/zsh/site-functions
%{_datadir}/zsh/site-functions/_doctl
%dir %{_datadir}/fish
%dir %{_datadir}/fish/vendor_completions.d
%{_datadir}/fish/vendor_completions.d/doctl.fish

%changelog
